#!/bin/bash

mount -o remount,rw /
rclone copy /data/output/Camera1 vmfb_gdrive:/<gdrive_video_path> --include "*.mp4" --local-no-check-updated --config /root/.config/rclone/rclone.conf 
rclone copy /data/log vmfb_gdrive:/<gdrive_log_path> --local-no-check-updated --config /root/.config/rclone/rclone.conf 
